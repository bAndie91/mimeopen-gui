sub app_dirs {
	return map { File::Spec->catdir($_, 'applications') } dirname($xdg->data_home), $xdg->data_dirs_list;
}

sub existing_mimeapps_files {
	my @desktops = map { lc } grep { length } split /:/, ($ENV{XDG_CURRENT_DESKTOP} // '');
	my @dirs = (
		dirname($xdg->config_home), $xdg->config_dirs_list,
		app_dirs(),
	);
	my @out;
	for my $d (@dirs) {
		for my $desktop (@desktops) {
			my $f = "$d/$desktop-mimeapps.list";
			push @out, $f if -f $f;
		}
		my $f = "$d/mimeapps.list";
		push @out, $f if -f $f;
	}
	return @out;
}

sub btnclk_edit
{
