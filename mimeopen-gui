sub custom_cmd_changed
{
	my ($entry) = @_;
	return 1 if $custom_command_input_changed_signal_lock;
	
	$app_selection_changed_signal_lock = 1;
	$slist->get_selection->unselect_all;
	$app_selection_changed_signal_lock = 0;
	return 1;
}

sub click_list
{
	return 1 if $app_selection_changed_signal_lock;
	
	my ($app_n) = $slist->get_selected_indices();
	my $selected_app = app_at($app_n);
	if(defined $selected_app)
	{
		my $exec_str = $selected_app->get('Exec');
		$custom_command_input_changed_signal_lock = 1;
		$input_cmd->set_text($exec_str);
		$custom_command_input_changed_signal_lock = 0;
	}
	return 1;
}

sub app_at
{
	# application of a list row, regardless of the order of the rows
	my ($slist_index) = @_;
	return undef if not defined $slist_index;
	my $row = $slist->{'data'}->[$slist_index];
	return undef if not defined $row;
	my $app_n = $row->[$slist_app_index_colum_index];
	return $app_n >= 0 ? $apps[$app_n] : undef;
}

sub find_desktop_entry
{
	my ($desktop_file_name) = @_;
	my $file = File::BaseDir::data_files('applications', $desktop_file_name);
	return $file ? File::DesktopEntry->new($file) : undef;
}

sub app_property
{
	# a property of an application (File::DesktopEntry object) in the user's language, eg. Name[hu] or Comment[hu];
	# each property falls back to its unlocalized value independently of the others
	my ($app, $key) = @_;
	my $file = $app->{'file'};
	if(defined $file and length $file)
	{
		my $value = DesktopEntryL10n::get($file, $key);
		return $value if defined $value;
	}
	# not backed by a readable file (eg. the custom command), or the key is missing
	return $app->get($key);
}

sub env_dirs
{
	my ($var, $default) = @_;
	my $value = $ENV{$var};
	$value = $default if not defined $value or $value eq '';
	return grep {length $_} split ':', $value;
}

sub user_mimeapps_file
{
	return File::BaseDir::config_home('mimeapps.list');
}

sub is_user_path
{
	# per-user location: under the home directory, or in the XDG_*_HOME directories
	my ($path) = @_;
	my @roots = grep {defined $_ and length $_} (
		$ENV{'HOME'},
		(getpwuid($<))[7],
		dirname(File::BaseDir::config_home('mimeapps.list')),
		dirname(dirname(File::BaseDir::data_home('applications', 'mimeapps.list'))),
	);
	$path = File::Spec->canonpath($path);
	return scalar grep {my $root = File::Spec->canonpath($_); $root ne File::Spec->rootdir and index($path, "$root/") == 0} @roots;
}

sub mimeapps_files
{
	# all the files which the library reads, the most precedent first
	my @files = (
		user_mimeapps_file(),
		(map {File::Spec->catfile($_, 'mimeapps.list')} env_dirs('XDG_CONFIG_DIRS', '/etc/xdg')),
		File::BaseDir::data_home('applications', 'mimeapps.list'),
		(map {File::Spec->catfile($_, 'applications', 'mimeapps.list')} env_dirs('XDG_DATA_DIRS', '/usr/local/share:/usr/share')),
		File::BaseDir::data_home('applications', 'defaults.list'),
	);
	my %seen;
	return grep {!$seen{$_}++} @files;
}

sub layer_files
{
	# files of the per-user ('user') or the system-wide ('system') settings
	my ($which) = @_;
	my $primary = user_mimeapps_file();
	return grep {$which eq 'user' ? ($_ eq $primary or is_user_path($_)) : ($_ ne $primary and !is_user_path($_))} mimeapps_files();
}

sub layer_target
{
	# the file to set default apps in: the user's mimeapps.list, or the first writable system-wide one
	my ($which) = @_;
	if($which eq 'user')
	{
		my $file = user_mimeapps_file();
		return path_writable($file) ? $file : undef;
	}
	for my $file (grep {basename($_) eq 'mimeapps.list'} layer_files('system'))
	{
		return $file if path_writable($file);
	}
	return undef;
}

sub path_writable
{
	my ($path) = @_;
	return -w $path if -e $path;
	# the file could be created if its closest existing parent directory is writable
	my $dir = dirname($path);
	while(!-d $dir and dirname($dir) ne $dir) { $dir = dirname($dir); }
	return (-d $dir and -w $dir and -x $dir) ? 1 : 0;
}

sub names_in_file
{
	# desktop file names set as default for the mime type keys in a file, most preferred first
	my ($file, @mime_keys) = @_;
	my %seen;
	return grep {!$seen{$_}++} map {my @l = eval { File::MimeInfo::Applications::_read_list($_, $file) }; @l} @mime_keys;
}

sub load_default_apps_config
{
	%Default_Names = ();
	%Default_Files = ();
	for my $which ('user', 'system')
	{
		$Default_Names{$which} = [];
		$Default_Files{$which} = {};
		for my $file (layer_files($which))
		{
			for my $name (names_in_file($file, @default_mime_keys))
			{
				push @{$Default_Names{$which}}, $name if not $Default_Files{$which}->{$name};
				push @{$Default_Files{$which}->{$name}}, $file if not grep {$_ eq $file} @{$Default_Files{$which}->{$name}};
			}
		}
	}
}

sub set_default_names
{
	# set the default apps of a mime type in a file (the user's one by default); no apps removes the mime type
	my ($file, $mime_type, @desktop_file_names) = @_;
	if(not defined $file or $file eq user_mimeapps_file())
	{
		if(@desktop_file_names)
		{
			# the library takes the name of a .desktop file and saves it as is: a list goes the same way
			mime_applications_set_default($mime_type, join(';', @desktop_file_names));
		}
		else
		{
			File::MimeInfo::Applications::_write_list($mime_type, undef);
		}
	}
	else
	{
		# the library writes the user's file only
		File::MimeInfo::Applications::_write_list($mime_type, @desktop_file_names ? join(';', @desktop_file_names) : undef, $file);
	}
}

sub merge_default_list
{
	# ticked apps in the order of the list, while entries which are not on the list (eg. not installed apps) are kept where they were
	my ($existing, $ticked, $known) = @_;
	my @new = @$ticked;
	for my $i (0 .. $#{$existing})
	{
		next if $known->{$existing->[$i]};
		splice @new, ($i < scalar @new ? $i : scalar @new), 0, $existing->[$i];
	}
	return @new;
}

sub save_user_default_apps
{
	# save the ticked applications in the order of the rows, top is the most preferred
	my $file = user_mimeapps_file();
	my @existing = names_in_file($file, @default_mime_keys);
	my %known = map {(basename($_->{'file'}) => 1)} @apps;
	my %seen;
	my @ticked = ();
	for my $slist_index (0 .. $#{$slist->{'data'}})
	{
		next if not $slist->{'data'}->[$slist_index]->[$slist_default_app_checkbox_colum_index];
		my $app = app_at($slist_index);
		next if not defined $app;
		my $name = basename($app->{'file'});
		push @ticked, $name if not $seen{$name}++;
	}
	
	# an app unticked is removed from the other per-user files as well
	for my $other_file (grep {$_ ne $file} layer_files('user'))
	{
		for my $key (@default_mime_keys)
		{
			my @names = names_in_file($other_file, $key);
			my @kept = grep {!($known{$_} and not $seen{$_})} @names;
			set_default_names($other_file, $key, @kept) if scalar @kept != scalar @names;
		}
	}
	
	# all the ticked apps are set in the order of the rows in the primary file
	my @new = merge_default_list(\@existing, \@ticked, \%known);
	# reordering of unticked apps changes nothing
	if(join(';', @new) ne join(';', @existing))
	{
		my @keys = ($default_mime_type);
		# keep the alias in sync if it has its own setting
		push @keys, grep {$_ ne $default_mime_type and names_in_file($file, $_)} @default_mime_keys;
		set_default_names($file, $_, @new) for @keys;
	}
	load_default_apps_config();
}

sub save_system_default_app
{
	my ($slist_index, $ticked) = @_;
	my $app = app_at($slist_index);
	my $name = basename($app->{'file'});
	if($ticked)
	{
		my $file = layer_target('system');
		die "No writable system-wide settings file\n" if not defined $file;
		my @names = names_in_file($file, $default_mime_type);
		return if grep {$_ eq $name} @names;
		# before the first app which is below this one in the list
		my %row_of;
		for my $i (0 .. $#{$slist->{'data'}})
		{
			my $row_app = app_at($i);
			$row_of{basename($row_app->{'file'})} = $i if defined $row_app;
		}
		my $position = scalar @names;
		for my $i (0 .. $#names)
		{
			if(defined $row_of{$names[$i]} and $row_of{$names[$i]} > $slist_index) { $position = $i; last; }
		}
		splice @names, $position, 0, $name;
		set_default_names($file, $default_mime_type, @names);
	}
	else
	{
		for my $file (@{$Default_Files{'system'}->{$name} || []})
		{
			die "Not writable: $file\n" if not path_writable($file);
			for my $key (@default_mime_keys)
			{
				my @names = names_in_file($file, $key);
				next if not grep {$_ eq $name} @names;
				set_default_names($file, $key, grep {$_ ne $name} @names);
			}
		}
	}
	load_default_apps_config();
}

sub checkbox_editable
{
	my ($which, $app_n, $is_ticked) = @_;
	return 0 if not defined $default_mime_type;
	# to tick it, there is a file to write it in
	return defined layer_target($which) ? 1 : 0 if not $is_ticked;
	# to untick it, it is to be removed from all the files which set it
	my $name = basename($apps[$app_n]->{'file'});
	my @files = @{$Default_Files{$which}->{$name} || []};
	return (@files and not grep {!path_writable($_)} @files) ? 1 : 0;
}

sub make_checkbox_cell_data_func
{
	my ($which) = @_;
	my $ticked_colum_index = $which eq 'system' ? $slist_system_default_app_checkbox_colum_index : $slist_default_app_checkbox_colum_index;
	return sub {
		my ($column, $cell, $model, $iter) = @_;
		my $app_n = $model->get($iter, $slist_app_index_colum_index);
		if($app_n < 0)
		{
			# custom application row
			$cell->set(visible => FALSE);
			return;
		}
		my $editable = checkbox_editable($which, $app_n, $model->get($iter, $ticked_colum_index));
		$cell->set(visible => TRUE, sensitive => $editable, activatable => $editable);
	};
}

sub checkbox_tooltip_text
{
	my ($which, $app_n, $is_ticked) = @_;
	my $app = $apps[$app_n];
	return undef if not defined $app or not defined $default_mime_type;
	my $name = basename($app->{'file'});
	my $settings = $which eq 'system' ? 'system settings' : 'user settings';
	my $text;
	if($is_ticked)
	{
		$text = "Default Application in $settings\n" . join("\n", @{$Default_Files{$which}->{$name} || []});
	}
	else
	{
		my $file = layer_target($which);
		$text = defined $file ? "Set as default Application in $settings\n" . $file : "Not default Application in $settings";
	}
	return $text;
}

sub list_tooltip
{
	my ($widget, $x, $y, $keyboard_mode, $tooltip) = @_;
	return FALSE if $keyboard_mode;
	my ($bin_x, $bin_y) = $slist->convert_widget_to_bin_window_coords($x, $y);
	my ($path, $column) = $slist->get_path_at_pos($bin_x, $bin_y);
	return FALSE if not defined $path or not defined $column;
	my $which = {'is_default' => 'user', 'is_default_system' => 'system'}->{$column->get_title};
	return FALSE if not defined $which;
	my ($slist_index) = $path->get_indices;
	my $row = $slist->{'data'}->[$slist_index];
	return FALSE if not defined $row or $row->[$slist_app_index_colum_index] < 0;
	my $is_ticked = $row->[$which eq 'system' ? $slist_system_default_app_checkbox_colum_index : $slist_default_app_checkbox_colum_index];
	my $text = checkbox_tooltip_text($which, $row->[$slist_app_index_colum_index], $is_ticked);
	return FALSE if not defined $text;
	$tooltip->set_text($text);
	$slist->set_tooltip_cell($tooltip, $path, $column, ($column->get_cell_renderers)[0]);
	return TRUE;
}

sub list_rows_reordered
{
	return if $list_reorder_pending;
	$list_reorder_pending = 1;
	# let the drag-and-drop finish (insertion of the new row and deletion of the old one)
	Glib::Idle->add(sub {
		$list_reorder_pending = 0;
		
		# the row of the custom application is always the last one
		my $model = $slist->get_model;
		my $last = $#{$slist->{'data'}};
		for my $slist_index (0 .. $last - 1)
		{
			if($slist->{'data'}->[$slist_index]->[$slist_app_index_colum_index] < 0)
			{
				$model->move_before($model->get_iter(Gtk2::TreePath->new($slist_index)), undef);
				last;
			}
		}
		
		eval { save_user_default_apps(); 1 } or warn $@;
		return FALSE;
	});
	return 1;
}

sub toggle_default_app_checkbox
{
	my ($cellrenderer, $slist_index, $which) = @_;
	my $ticked_colum_index = $which eq 'system' ? $slist_system_default_app_checkbox_colum_index : $slist_default_app_checkbox_colum_index;
	# the list already flipped the value
	my $is_ticked = $slist->{'data'}->[$slist_index]->[$ticked_colum_index];
	my $done = 0;
	my $app = app_at($slist_index);
	if(defined $app and defined $default_mime_type
		and checkbox_editable($which, $slist->{'data'}->[$slist_index]->[$slist_app_index_colum_index], !$is_ticked))
	{
		eval { $which eq 'system' ? save_system_default_app($slist_index, $is_ticked) : save_user_default_apps(); 1 };
		$done = !$@;
		warn $@ if $@;
	}
	if(!$done)
	{
		$slist->{'data'}->[$slist_index]->[$ticked_colum_index] = !$is_ticked;
	}
}

sub try_run
{
	my ($selected_app, $exe, $filepath) = @_;
	my $pid = fork;

	if(not defined $pid)
	{
		error_message("Can not fork.");
		exit 12;
	}
	elsif($pid == 0)
	{
		if(defined $selected_app) {
			$selected_app->exec($filepath);
		} else {
			exec($exe, $filepath);
		}
		exit 127;
	}
	else
	{
		$CHILD->{$pid} = {};
		if(defined $selected_app) {
			$CHILD->{$pid}->{'appname'} = app_property($selected_app, 'Name');
		} else {
			$CHILD->{$pid}->{'appname'} = basename($exe);
		}
	}
}

sub try_run_multi
{
	my ($selected_app, $exe, @paths) = @_;
	for my $filepath (@paths)
	{
		try_run($selected_app, $exe, $filepath);
	}
	$window->hide();
	Glib::Timeout->add(300, \&check_children);
}

sub check_children
{
	for my $pid (keys %$CHILD)
	{
		if(exists $CHILD->{$pid}->{'status'})
		{
			my $wstatus = $CHILD->{$pid}->{'status'};
			my $status = $wstatus & 127;
			my $signal = $wstatus >> 8;
			if($status != 0 or $signal != 0)
			{
				error_message(sprintf("Could not run %s.", $CHILD->{$pid}->{'appname'}), "error $status, signal $signal");
			}
			delete $CHILD->{$pid};
			my $xstatus = $signal ? 128 + $signal : $status;
			$EXIT_STATUS = $xstatus if $xstatus > $EXIT_STATUS;
		}
	}
	if(not %$CHILD)
	{
		main_quit();
		return 0;
	}
	return 1;  # keep running
}

sub btnclk_open
{
	my ($app_n) = $slist->get_selected_indices();
	if(defined $app_n)
	{
		my $selected_app = app_at($app_n);
		if(defined $selected_app)
		{
			try_run_multi($selected_app, undef, @Files)
		}
		else
		{
			my $exe;
			my $dlg = new Gtk2::FileChooserDialog("Select an Application", $window, 'open');
			$dlg->add_button('gtk-execute', 'ok');
			$dlg->add_button('gtk-cancel', 'cancel');
			if($dlg->run() eq 'ok')
			{
				$exe = $dlg->get_filename();
			}
			$dlg->destroy();
			if(defined $exe)
			{
				try_run_multi(undef, $exe, @Files);
			}
		}
	}
	else
	{
		my $exec_str = $input_cmd->get_text;
		my $basename = (split /\/+/, (split /\s+/, $exec_str)[0])[-1];
		my $desktop_entry = 
			"[Desktop Entry]".$LF.
			"Name=$basename - mimeopen-gui custom command".$LF.
			"Exec=$exec_str".$LF.
			"Type=Application".$LF.
			"StartupNotify=true";
		my $app = File::DesktopEntry->new(\$desktop_entry);
		try_run_multi($app, undef, @Files);
	}
}

