# File::MimeInfo::Applications does not respect the sections of the mimeapps.list files:
# it reads and writes the key in any section, and adds new lines to the end of the file.
# Monkey-patch it to deal with the [Default Applications] section only (or [MIME Cache] of mimeinfo.cache),
# and never touch the other sections, like [Added Associations].
{
	no warnings 'redefine';
	
	*File::MimeInfo::Applications::_read_list = sub {
		# read list with "mime/type=foo.desktop;bar.desktop" format
		my $mimetype = shift;
		my @list;
		my $succeeded;
		for my $file (@_)
		{
			next if not defined $file;
			open my $fh, '<', $file or next;
			$succeeded = 1;
			my @lines = <$fh>;
			close $fh;
			my $wanted_section = basename($file) eq 'mimeinfo.cache' ? 'MIME Cache' : 'Default Applications';
			my $has_section = grep {/^\s*\[.*\]\s*$/} @lines;
			my $section = undef;
			for my $line (@lines)
			{
				if($line =~ /^\s*\[(.*?)\]\s*$/) { $section = $1; next; }
				next if $has_section and (not defined $section or $section ne $wanted_section);
				$line =~ /^\Q$mimetype\E\s*=\s*(.*?)\s*$/ or next;
				push @list, grep {defined $_ and length $_} split ';', $1;
			}
		}
		Carp::croak("Could not read any defaults, tried:\n" . join("\t\n", @_)) unless $succeeded;
		return @list;
	};
	
	*File::MimeInfo::Applications::_write_list = sub {
		# set the list of a mime type, or remove the mime type if the value is undef;
		# optional third argument is the file to write instead of the user's mimeapps.list
		my ($mimetype, $value, $file) = @_;
		$file = File::BaseDir::config_home('mimeapps.list') if not defined $file;
		my @lines;
		if(-f $file)
		{
			open my $fh, '<', $file or Carp::croak("Could not read file: $file");
			@lines = <$fh>;
			close $fh;
			$lines[-1] .= "\n" if @lines and $lines[-1] !~ /\n\z/;
		}
		else
		{
			return if not defined $value;
			File::MimeInfo::Applications::_mkdir($file);
		}
		
		my $new_line = (defined $value and length $value) ? "$mimetype=$value;\n" : undef;
		my ($section, @kept, $head_index, $end_index, $replaced);
		for my $line (@lines)
		{
			if($line =~ /^\s*\[(.*?)\]\s*$/)
			{
				$end_index = scalar @kept if defined $head_index and not defined $end_index;
				$section = $1;
				push @kept, $line;
				$head_index = $#kept if not defined $head_index and $section eq 'Default Applications';
				next;
			}
			if(defined $section and $section eq 'Default Applications' and $line =~ /^\Q$mimetype\E\s*=/)
			{
				# replace in place, drop duplicates
				push @kept, $new_line if defined $new_line and not $replaced;
				$replaced = 1;
				next;
			}
			push @kept, $line;
		}
		if(defined $new_line and not $replaced)
		{
			if(defined $head_index)
			{
				# to the end of the section, but before the blank lines which separate it from the next one
				my $at = defined $end_index ? $end_index : scalar @kept;
				$at-- while $at > $head_index + 1 and $kept[$at - 1] =~ /^\s*$/;
				splice @kept, $at, 0, $new_line;
			}
			else
			{
				push @kept, "\n" if @kept and $kept[-1] !~ /^\s*$/;
				push @kept, "[Default Applications]\n", $new_line;
			}
		}
		
		open my $fh, '>', $file or Carp::croak("Could not write file: $file");
		print $fh @kept;
		close $fh or Carp::croak("Could not write file: $file");
	};
}

%mime_types = ();
%file_mime_types = ();

if($Files[0] =~ /^([[:alnum:]\+\.-]+):/)
{
	if(scalar @Files > 1) { die $usagetext; }
	$uri = $Files[0];
	$mime_types{"x-scheme-handler/$1"} = 1;
	$file_mime_types{$uri}{"x-scheme-handler/$1"} = 1;
}
else
{
	for my $filepath (@Files)
	{
		my $mime_type;
		if($xattr_available)
		{
			$mime_type = getxattr($filepath, 'user.mime_type');
		}
		
		if(not defined $mime_type)
		{
			if(-d $filepath)
			{
				$mime_type = "inode/directory";
			}
			elsif(-p $filepath)
			{
				$mime_type = "inode/fifo";
			}
			elsif(-S $filepath)
			{
				$mime_type = "inode/socket";
			}
			elsif(-c $filepath)
			{
				$mime_type = "inode/chardevice";
			}
			elsif(-b $filepath)
			{
				$mime_type = "inode/blockdevice";
			}
			else
			{
				$mime_type = magic($filepath) if not $mime_type;
				$mime_type = File::MimeInfo::mimetype($filepath) if not $mime_type;
				$mime_type = File::MimeInfo::default($filepath) if not $mime_type;
			}
		}
		
		$mime_types{$mime_type} = 1 if defined $mime_type;
		$file_mime_types{$filepath}{$mime_type} = 1 if defined $mime_type;
		
		my ($extension) = $filepath =~ /\.([^.]+)$/;
		if($extension)
		{
			my $mime_type_by_ext = File::MimeInfo::mimetype('*.'.$extension);
			$mime_types{$mime_type_by_ext} = 1 if $mime_type_by_ext;
			$file_mime_types{$filepath}{$mime_type_by_ext} = 1 if $mime_type_by_ext;
		}
	}
}

@mime_types = keys %mime_types;


@all_default_apps = ();
@all_canonical_apps = ();
@all_other_nonaliased_apps = ();
%App_Mime_Types = ();

for my $mime_type (@mime_types)
{
	my $canon_mime_type = mimetype_canon $mime_type;
	my @canonical_apps = mime_applications_all($mime_type);
	map {$_->{'mime_type'} = $canon_mime_type if defined $_} @canonical_apps;
	push @all_canonical_apps, @canonical_apps;
	
	my @default_nonaliased_apps = File::MimeInfo::Applications::_default($mime_type);
	my @other_nonaliased_apps = File::MimeInfo::Applications::_others($mime_type);
	map {$_->{'mime_type'} = $mime_type if defined $_} @default_nonaliased_apps, @other_nonaliased_apps;
	push @all_other_nonaliased_apps, @other_nonaliased_apps;
	
	my @default_apps = ($canonical_apps[0], @default_nonaliased_apps);
	if(scalar @mime_types == 1)
	{
		# the library knows only one default app, but there can be more of them in the preferences
		$default_mime_type = $canon_mime_type;
		@default_mime_keys = ($canon_mime_type);
		push @default_mime_keys, $mime_type if $mime_type ne $canon_mime_type;
		load_default_apps_config();
		my %seen_default_name;
		@default_apps = grep {defined} map {find_desktop_entry($_)} grep {!$seen_default_name{$_}++} (@{$Default_Names{'user'}}, @{$Default_Names{'system'}});
		map {$_->{'mime_type'} = $canon_mime_type} @default_apps;
	}
	map {$_->{'is_default_app'} = 1 if defined $_} @default_apps;
	push @all_default_apps, @default_apps;
	
	map {$App_Mime_Types{$_->get('Exec')}{$mime_type} = 1 if defined $_} @canonical_apps, @default_apps, @default_nonaliased_apps, @other_nonaliased_apps;
}

%FilterApps_Seen = ();
