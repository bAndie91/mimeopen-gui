sub icondir2size
{
	return(($_[0] =~ /\/(\d+)x\d+/)[0]);
}


sub set_list_app_items
{
	my ($slist, @apps) = @_;
	my $slist_data = $slist->{'data'};
	my $pref_size = 48;
	my $select_index_by_default = undef;
	my $index = -1;
	
	for my $app (@apps)
	{
		$index ++;
		my $pxb;
		my $iconname = $app->get('Icon');
		my $appname = app_property($app, 'Name');
		if($iconname)
		{
			my $iconpath;
			if($iconname =~ /^\//)
			{
				$iconpath = $iconname;
			}
			else
			{
				my @dirs;
				for my $c ('hicolor', 'locolor', 'gnome')
				{
					my $d = "/usr/share/icons/${c}";
					my @small;
					for my $e (sort {icondir2size($a) <=> icondir2size($b)} glob "$d/*x*/*")
					{
						if(icondir2size($e) < $pref_size)
						{
							unshift @small, $e;
						}
						else
						{
							push @dirs, $e;
						}
					}
					push @dirs, "$d/scalable/*";
					for my $e (@small)
					{
						push @dirs, $e;
					}
				}
				push @dirs, '/usr/share/pixmaps';
				
				FINDICON:
				for my $icondir (@dirs)
				{
					my $iconpath_test;
					for my $iconext ('png', 'xpm', 'svg')
					{
						if($iconname =~ /\./)
						{
							$iconpath_test = $icondir . '/'. $iconname;
						}
						else
						{
							$iconpath_test = $icondir . '/'. $iconname . '.' . $iconext;
						}
						if(-e $iconpath_test)
						{
							$iconpath = $iconpath_test;
							last FINDICON;
						}
						elsif($iconname =~ /\./)
						{
							next FINDICON;
						}
					}
				}
			}
			if(defined $iconpath)
			{
				eval {
					$pxb = Gtk2::Gdk::Pixbuf->new_from_file_at_scale($iconpath, $pref_size, -1, TRUE);
					1;
				}
				or $pxb = undef;
			}
		}
		
		$select_index_by_default = $index if not defined $select_index_by_default and $app->{'is_default_app'};
		my $desktop_file_name = basename($app->{'file'});
		my $user_default = (defined $default_mime_type and $Default_Files{'user'}->{$desktop_file_name}) ? TRUE : FALSE;
		my $system_default = (defined $default_mime_type and $Default_Files{'system'}->{$desktop_file_name}) ? TRUE : FALSE;
		push @$slist_data, [$pxb,
			sprintf("<big>%s</big>\n<small>%s</small>\n<small><tt>%s</tt></small>", pango_escape($appname), pango_escape(app_property($app, 'Comment')), pango_escape($app->get('Exec'))),
			$user_default, $system_default, $index];
	}
	
	$slist->select($select_index_by_default || 0);
	push @$slist_data, [Gtk2::Button->new->render_icon('gtk-add', 'button'), '<big>'."Custom application...".'</big>', FALSE, FALSE, -1];
}

sub filter_apps
{
	my $a = $_;
	return 0 if !defined $a;
	my $x = $a->get('Exec');
	# keep only apps which can open all the files (intersection, not union)
	for my $filepath (@Files)
	{
		my @file_mime_types = keys %{$file_mime_types{$filepath} || {}};
		next if not @file_mime_types;
		return 0 if not grep {$App_Mime_Types{$x}{$_}} @file_mime_types;
	}
	my $seen = $FilterApps_Seen{$x};
	$FilterApps_Seen{$x} = 1;
	return !$seen;
}


