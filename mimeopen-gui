sub icondir2size
{
	return(($_[0] =~ /\/(\d+)x\d+/)[0]);
}

sub pango_escape
{
	my ($s) = @_;
	$s =~ s/</&lt;/g;
	$s =~ s/>/&gt;/g;
	$s =~ s/&/&amp;/g;
	return $s;
}

sub set_list_app_items
{
	my ($slist, @apps) = @_;
	my $slist_data = $slist->{'data'};
	my $pref_size = 24;
	my $select_index_by_default = undef;
	my $index = -1;
	
	for my $app (@apps)
	{
		$index ++;
		my $pxb;
		my $iconname = $app->get('Icon');
		my $appname = $app->get('Name');
		if($iconname)
		{
			my $iconpath;
			if($iconname =~ /^\//)
			{
				$iconpath = $iconname;
			}
			else
			{
				my @dirs;
				for my $c ('hicolor', 'locolor', 'gnome')
				{
					my $d = "/usr/share/icons/${c}";
					my @small;
					for my $e (sort {icondir2size($a) <=> icondir2size($b)} glob "$d/*x*/*")
					{
						if(icondir2size($e) < $pref_size)
						{
							unshift @small, $e;
						}
						else
						{
							push @dirs, $e;
						}
					}
					push @dirs, "$d/scalable/*";
					for my $e (@small)
					{
						push @dirs, $e;
					}
				}
				push @dirs, '/usr/share/pixmaps';
				
				FINDICON:
				for my $icondir (@dirs)
				{
					my $iconpath_test;
					for my $iconext ('png', 'xpm', 'svg')
					{
						if($iconname =~ /\./)
						{
							$iconpath_test = $icondir . '/'. $iconname;
						}
						else
						{
							$iconpath_test = $icondir . '/'. $iconname . '.' . $iconext;
						}
						if(-e $iconpath_test)
						{
							$iconpath = $iconpath_test;
							last FINDICON;
						}
						elsif($iconname =~ /\./)
						{
							next FINDICON;
						}
					}
				}
			}
			if(defined $iconpath)
			{
				eval {
					$pxb = Gtk2::Gdk::Pixbuf->new_from_file_at_scale($iconpath, $pref_size, -1, TRUE);
					1;
				}
				or $pxb = undef;
			}
		}
		
		$select_index_by_default = $index if not defined $select_index_by_default and $app->{'is_default_app'};
		push @$slist_data, [$pxb, sprintf("<big>%s</big>\n<small>%s</small>", pango_escape($appname), pango_escape($app->get('Exec'))), $app->{'is_default_app'} ? TRUE : FALSE];
	}
	
	$slist->select($select_index_by_default || 0);
	push @$slist_data, [Gtk2::Button->new->render_icon('gtk-add', 'button'), '<big>'."Custom application...".'</big>', FALSE];
}

sub filter_apps
{
	my $a = $_;
	return 0 if !defined $a;
	my $x = $a->get('Exec');
	my $seen = $FilterApps_Seen{$x};
	$FilterApps_Seen{$x} = 1;
	return !$seen;
}


sub main_window_configure
{
	my ($widget, $event) = @_;
	$Config->set('window.width', $event->width);
	$Config->set('window.height', $event->height);
	return '';
}


package LabelRow;

sub new {
	my ($class) = @_;
	my $self = bless {
		container => new Gtk2::HBox(),
		intro => new Gtk2::Label(),
		scroller => new Gtk2::ScrolledWindow(),
		label => new Gtk2::Label(),
	}, $class;
	$self->init();
	return $self;
}

sub init {
	my ($self) = @_;
	$self->{intro}->set_alignment(0, 0);
	$self->{label}->set_alignment(0, 0);
	$self->{label}->set_selectable(TRUE);
	$self->{scroller}->set_policy('never', 'never');
	$self->{scroller}->add_with_viewport($self->{label});
	$self->{container}->pack_start($self->{intro}, FALSE, TRUE, 0);
	$self->{container}->pack_start($self->{scroller}, TRUE, TRUE, 0);
	$self->{scroller}->get_children->set_shadow_type('none');
	$self->{scroller}->set_size_request(295, -1);
	$self->{scroller}->get_children->signal_connect('scroll-event' => \&scroll_viewport);
}

sub container { return $_[0]->{container}; }
sub intro { return $_[0]->{intro}; }
sub label { return $_[0]->{label}; }
sub intro_text { return defined $_[1] ? $_[0]->intro->set_text($_[1]) : $_[0]->intro->get_text; }
sub label_text { return defined $_[1] ? $_[0]->label->set_text($_[1]) : $_[0]->label->get_text; }
sub label_markup { return defined $_[1] ? $_[0]->label->set_markup($_[1]) : $_[0]->label->get_markup; }

sub scroll_viewport
{
	my ($self, $event) = @_;
	my $scrwin = $self->parent;
	my $dir = $event->direction;
	my $adj = $scrwin->get_hadjustment;
	my $delta = ($dir eq 'down' or $dir eq 'left') ? +10 : -10;
	my $new = $adj->value + $delta;
	my $width = $self->get_allocation->width;
	$new = $adj->upper - $width if $new + $width > $adj->upper;
	$adj->set_value($new);
}
