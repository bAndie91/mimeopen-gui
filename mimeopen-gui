## Subroutines

sub list_of_system_commands
{
	my %commands;
	for my $dir (split /:/, $ENV{'PATH'})
	{
		for my $file (glob "$dir/*")
		{
			if(-x $file)
			{
				$file =~ /\/([^\/]+)$/;
				my $name = $1;
				$commands{$name}=1;
			}
		}
	}
	return keys %commands;
}

sub error_message
